# 1) Bu faylni .env nomi bilan nusxalang:  cp .env.example .env   (Windows: copy .env.example .env)
# 2) Qiymatlarni to‘ldiring, so‘ng:        npm run config     → js/config.js avtomatik yaratiladi
# Brauzer .env ni o‘qiy olmaydi, shu sababli config.js yaratiladi. Quyidagi ikkisi OMMAVIY qiymatlar.

# Supabase Dashboard > Project Settings > API > Project URL
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase Dashboard > Project Settings > API Keys > Publishable key (sb_publishable_...). Eski loyihada anon kalit ham bo‘ladi.
# service_role / secret kalitni BU YERGA YOZMANG!
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY

# MAXFIY (hech qayerga, repoga ham, frontendga ham yozilmaydi — faqat Supabase Dashboard > Authentication > Providers > Google ga kiritiladi):
#   Google Client ID  (...apps.googleusercontent.com)
#   Google Client Secret
